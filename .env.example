APP_NAME="SmartPRS 3"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://smartprs3.test
APP_TIMEZONE=UTC

# Instants are stored UTC (spine S16). This is the tenant's *business* timezone,
# used to derive the business date. Per-tenant values override it at runtime.
SMARTPRS_DEFAULT_BUSINESS_TIMEZONE=Asia/Kolkata
SMARTPRS_DEFAULT_CURRENCY=INR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs3
DB_USERNAME=root
DB_PASSWORD=

# Law 2 — the application user must NOT hold ALTER, CREATE or DROP in any
# environment above local. Migrations run as a separate, privileged user.
DB_MIGRATION_USERNAME=smartprs3_migrator
DB_MIGRATION_PASSWORD=

# Spine S2 — the queue and the scheduler are mandatory, not optional. The
# installer refuses to complete without both, and the health check fails loudly
# if either stops.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# R-XXII-206: secure by default, in every environment. There is no "off" setting
# for a deployment served over HTTP other than a declared local loopback, and the
# only way to get an insecure cookie is SessionPolicy(loopbackDevelopment: true)
# in code — not an env var someone copies into production. SmartPRS 2 shipped
# this false with no default at all; that is how it reached customers.
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
# Private documents are served through signed, expiring URLs only (spine S13).
# Nothing private is ever written to a publicly readable disk path.
SMARTPRS_PRIVATE_DISK=private
SMARTPRS_SIGNED_URL_TTL=300

# Statutory rule packs and application updates are verified against an Ametecs
# public key. The private signing key never leaves Ametecs (spine S12, S18).
SMARTPRS_RULE_PACK_PUBLIC_KEY_ID=
SMARTPRS_RULE_PACK_PUBLIC_KEY_PATH=storage/keys/rule-pack.pub

# Test database for `php tests/run.php` (the framework-free primitive suite).
SMARTPRS_TEST_DSN="mysql:host=127.0.0.1;charset=utf8mb4"
SMARTPRS_TEST_USER=smartprs3
SMARTPRS_TEST_PASSWORD=
SMARTPRS_TEST_DATABASE=smartprs3_schema_check
