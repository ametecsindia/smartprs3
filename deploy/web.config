<?xml version="1.0" encoding="UTF-8"?>
<!--
  SmartPRS 3 on Windows / IIS (on-premise clients). Put this file in the public\ folder,
  point the IIS site's physical path at public\, and install the IIS "URL Rewrite" module.
  Same routes as public/.htaccess (Apache) and deploy/nginx-app.smartprs.com.conf.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="app.php" /></files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="api-v1" stopProcessing="true"><match url="^api/v1/" /><action type="Rewrite" url="v1.php" appendQueryString="true" /></rule>
        <rule name="api-mobile" stopProcessing="true"><match url="^api/mobile/" /><action type="Rewrite" url="mobile.php" appendQueryString="true" /></rule>
        <rule name="api-v3" stopProcessing="true"><match url="^api/v3/" /><action type="Rewrite" url="api.php" appendQueryString="true" /></rule>
        <rule name="iclock" stopProcessing="true"><match url="^iclock/" /><action type="Rewrite" url="iclock.php" appendQueryString="true" /></rule>
        <rule name="update" stopProcessing="true"><match url="^update/" /><action type="Rewrite" url="update.php" appendQueryString="true" /></rule>
        <rule name="super" stopProcessing="true"><match url="^super/?$" /><action type="Rewrite" url="super.php" appendQueryString="true" /></rule>
        <rule name="demo" stopProcessing="true"><match url="^demo/?$" /><action type="Rewrite" url="demo.php" appendQueryString="true" /></rule>
        <rule name="activate" stopProcessing="true"><match url="^activate/?$" /><action type="Rewrite" url="activate.php" appendQueryString="true" /></rule>
        <rule name="login" stopProcessing="true"><match url="^login/?$" /><action type="Rewrite" url="app.php?r=signin" appendQueryString="true" /></rule>
        <rule name="branded" stopProcessing="true"><match url="^c/([A-Za-z0-9]+)/?$" /><action type="Rewrite" url="app.php?r=signin&amp;ws={R:1}" appendQueryString="true" /></rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments><add segment=".env" /><add segment=".git" /></hiddenSegments>
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
