# SmartPRS 3 — production .env for app.smartprs.com (copy to /var/www/smartprs3/.env).
# Never commit the real file. Generate APP_KEY with:  php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# APP_KEY encrypts licence keys and SmartEPT secrets — keep it, and back it up: changing it
# makes every stored licence key / webhook secret unreadable.

APP_NAME="SmartPRS 3"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://app.smartprs.com
APP_TIMEZONE=Asia/Kolkata
SMARTPRS_DEFAULT_BUSINESS_TIMEZONE=Asia/Kolkata
SMARTPRS_DEFAULT_CURRENCY=INR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs3
DB_USERNAME=smartprs3_app
DB_PASSWORD=CHANGE_ME_APP
# Runs migrations only (tools/db/migrate.php); the app account above never holds DDL.
DB_MIGRATION_USERNAME=smartprs3_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATOR

SESSION_SECURE_COOKIE=true
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@smartprs.com"
MAIL_FROM_NAME="SmartPRS"

# ---- Licensing (SmartPRS 2 parity) -------------------------------------------
# The cloud is the licence SERVER: on-prem installs call https://app.smartprs.com/update/*.
SMARTPRS_DEPLOYMENT=saas

# ---- For an ON-PREMISE client install use instead: ---------------------------
# SMARTPRS_DEPLOYMENT=onprem
# SMARTPRS_LICENCE_SERVER=https://app.smartprs.com
# SMARTPRS_LICENCE_ENFORCE=true      # false only for an internal demo box
# SMARTPRS_OFFLINE_LIC=false         # true lets a machine-locked .lic activate with no internet
