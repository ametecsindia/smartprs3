      "title": "at equal specificity the higher priority wins, and the trace names the loser",
      "decision_point": "attendance.day.penalise",
      "rules": [
        {
          "code": "RL-LOW",
          "when": "attendance.late_minutes > 10m",
          "priority": 0,
          "on_conflict": "highest_priority_only"
        },
        {
          "code": "RL-HIGH",
          "when": "attendance.late_minutes > 10m",
          "priority": 5,
          "on_conflict": "highest_priority_only"
        }
      ],
      "context": {
        "attendance.late_minutes": {
          "minutes": 30
        }
      },
      "expect": {
        "status": "matched",
        "emitted_by": "RL-HIGH",
        "trace_contains": [
          "RL-LOW",
          "outranked"
        ]
      }
    },
    {
