    {
      "id": "RC-18.a",
      "class": "RC-18",
      "kind": "rules_fault_injection",
      "title": "a fault at each of symbol resolution, aggregation, ledger read and scope resolution produces a named error and no actions",
      "note": "R-VII-015's mechanism was complete except for the declaration that arms it: Symbol carried the flag, SymbolTable had requiringNotNull(), the evaluator raised ERR_MISSING_INPUT, a unit test asserted the behaviour — and not one decision point declared a symbol, so the branch was unreachable and every missing input read as 'no rule matched'. SmartPRS 2's paidLeaveDays():1065 is the cost of that: an unknown type_id is treated as PAID, and LeaveController::apply() never writes type_id at all.",
      "faults": [
        {
          "name": "symbol resolution: day.date is not supplied",
          "decision_point": "attendance.day.classify",
          "rules": [
            {
              "code": "R-CLASSIFY",
              "when": "day.is_holiday = FALSE AND day.date >= #2026-01-01#",
              "action": "SET_STATUS"
            }
          ],
          "expect_error": "ERR_MISSING_INPUT",
          "context": {
            "day.is_holiday": {
              "boolean": false
            }
          }
        },
        {
          "name": "aggregation: no aggregator is available",
          "decision_point": "attendance.day.classify",
          "rules": [
            {
              "code": "R-AGG",
              "when": "agg.count(late_arrival, payroll_period) >= 3",
              "action": "SET_STATUS"
            }
          ],
          "expect_error": "ERR_AGG_UNAVAILABLE",
          "context": {}
        },
        {
          "name": "ledger read: the leave balance was never read",
          "decision_point": "leave.request.charge",
          "rules": [
            {
              "code": "R-BAL",
              "when": "leave.type = 'EL' AND leave.balance('EL') > 0d",
              "action": "CHARGE_DAY"
            }
          ],
          "expect_error": "ERR_MISSING_INPUT",
          "context": {
            "leave.type": {
              "code": "EL"
            }
          }
        },
        {
          "name": "scope resolution: two rules tie on specificity and priority",
          "decision_point": "attendance.day.classify",
          "rules": [
            {
              "code": "R-TIE-A",
              "when": "day.is_holiday = FALSE",
              "priority": 10,
              "scope": {
                "branch": "HYD"
              },
              "action": "SET_STATUS"
            },
            {
              "code": "R-TIE-B",
              "when": "day.is_holiday = FALSE",
              "priority": 10,
              "scope": {
                "branch": "HYD"
              },
              "action": "SET_STATUS"
            }
          ],
          "expect_error": "ERR_PRECEDENCE_TIE",
          "dimensions": {
            "branch": "HYD"
          },
          "context": {
            "day.is_holiday": {
              "boolean": false
            },
            "day.date": {
              "date": "2026-08-26"
            }
          }
        }
      ],
      "controls": [
