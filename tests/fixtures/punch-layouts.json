{
  "zkteco_dat": {
    "label": "ZKTeco .dat / .txt export — tab separated, no header",
    "delimiter": "\t",
    "header": false,
    "identifies": "device_user_id",
    "columns": {"device_user_id": 0, "punch_at": 1, "direction": 2, "verify_mode": 3, "device_sn": 4},
    "timestamp_format": "Y-m-d H:i:s",
    "directions": {"0": "in", "1": "out"}
  },
  "essl_csv": {
    "label": "eSSL CSV export — comma separated, header row, day-first instants",
    "delimiter": ",",
    "header": true,
    "identifies": "device_user_id",
    "columns": {"device_user_id": 0, "punch_at": 1, "direction": 2},
    "timestamp_format": "d/m/Y H:i:s",
    "directions": {"IN": "in", "OUT": "out"}
  },
  "no_directions": {
    "label": "Deliberately incomplete — used by the test to prove the layout is checked",
    "delimiter": ",",
    "columns": {"device_user_id": 0, "punch_at": 1, "direction": 2},
    "timestamp_format": "Y-m-d H:i:s"
  }
}
