{
  "note": "KRAs and KPIs — Organization Setup / Configuration. This is the CATALOGUE: which KRA a KPI belongs to, its description and how it is calculated — seeded from the collections/recovery industry's own KRA-KPI matrix. Nothing here is a target: a target is tenant data, scoped to a company/branch/role and effective-dated, kept in kra_kpi_targets (see surface/KraKpi.php), never in this file. `code` is a stable slug derived once from the KRA and KPI names — targets and achievement entries key on it, never on the display text, so renaming a KPI's label here does not orphan anything already published against it. A different vertical replaces this file; no code changes.",
  "kpis": [
    {
      "code": "collection-recovery--collection-amount",
      "kra": "Collection / Recovery",
      "kpi": "Collection Amount",
      "description": "Total amount collected during the period",
      "formula": "SUM(All successful collections)",
      "role": "achievement",
      "measures_against": "collection-recovery--collection-target"
    },
    {
      "code": "collection-recovery--collection-target",
      "kra": "Collection / Recovery",
      "kpi": "Collection Target",
      "description": "Amount expected to be collected",
      "formula": "Configured Target Amount",
      "role": "target"
    },
    {
      "code": "collection-recovery--collection-achievement",
      "kra": "Collection / Recovery",
      "kpi": "Collection Achievement %",
      "description": "Measures achievement against target",
      "formula": "(Actual Collection ÷ Target Collection) × 100",
      "role": "computed",
      "measures_against": "collection-recovery--collection-target"
    },
    {
      "code": "collection-recovery--recovery-amount",
      "kra": "Collection / Recovery",
      "kpi": "Recovery Amount",
      "description": "Amount recovered from overdue/defaulted accounts",
      "formula": "SUM(Overdue Amount Recovered)"
    },
    {
      "code": "collection-recovery--recovery-target-achievement",
      "kra": "Collection / Recovery",
      "kpi": "Recovery Target Achievement %",
      "description": "Recovery performance against assigned target",
      "formula": "(Actual Recovery ÷ Recovery Target) × 100"
    },
    {
      "code": "collection-recovery--collection-efficiency",
      "kra": "Collection / Recovery",
      "kpi": "Collection Efficiency %",
      "description": "Measures collection against collectible amount",
      "formula": "(Amount Collected ÷ Amount Due/Collectible) × 100"
    },
    {
      "code": "collection-recovery--net-collection-rate",
      "kra": "Collection / Recovery",
      "kpi": "Net Collection Rate",
      "description": "Collection after applicable reversals/refunds",
      "formula": "(Net Collection ÷ Total Collectible) × 100"
    },
    {
      "code": "collection-recovery--monthly-collection",
