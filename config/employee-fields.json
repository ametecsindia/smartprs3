{
  "self_service_excluded": ["emp_code", "ctc", "status", "salary_type", "comm_pct", "employer_company_id", "branch_id", "department_id", "designation_id", "team_id", "role", "reporting_manager_id", "doj", "training_start_date", "training_end_date", "employment_type", "employment_stage", "pf_applicable", "esi_applicable", "pt_applicable", "lwf_applicable", "tds_applicable", "shift", "schedule_id", "device_user_id", "probation_end", "confirmation_date", "notice_period_days", "cost_center", "grade_band", "business_unit", "work_location", "team_leader", "type", "also_works_for", "exit_date", "exit_reason", "rehire_eligible"],
  "self_service_note": "FIELDS AN EMPLOYEE MAY NOT CHANGE ABOUT THEMSELVES on My Details (owner, 28 Sep). Their company, branch, department, designation, reporting manager, joining date, type, statutory switches, shift and exit details are HR's; an employee who could edit their own branch widened what they could see, and one who could switch their own PF off changed their own payslip.",
  "note": "WHAT HR MAY HOLD ON AN EMPLOYEE, and which column on `employees` each of those things is. This is the register the Add form, self-onboarding and the bulk import sample are all built from, so a field turned on here appears in three places and a field turned off disappears from three places. It arrived as a JavaScript array inside a design artefact; here it is a file, because 'we also capture the mother's name' must not be a release.",
  "column_note": "`column` names the REAL column on `employees`. A field whose column is null is one this database has no room for yet: the screen offers it, says so on the row, and refuses to capture it until the column exists — because a field that appears to save and does not is discovered months later by whoever needed it. The check is made against the live table, never against this file, so a column added by migration lights its field up with no edit here.",
  "sections": [
    {
      "id": "personal",
      "title": "Personal Details",
      "accent": "#2F4A3E",
      "desc": "Identity and biographical information held on every employee.",
      "fields": [
        {
          "code": "emp_code",
          "label": "Employee Code",
          "type": "Alpha Numeric",
          "control": "text",
          "column": "emp_code",
          "core": true
        },
        {
          "code": "name",
          "label": "Full Name",
          "type": "Text",
          "control": "text",
          "column": "name",
          "core": true
        },
        {
          "code": "first_name",
          "label": "First Name",
          "type": "Text",
          "control": "text",
          "column": "first_name"
        },
        {
          "code": "middle_name",
          "label": "Middle Name",
          "type": "Text",
          "control": "text",
          "column": "middle_name"
        },
        {
          "code": "last_name",
          "label": "Last Name",
          "type": "Text",
          "control": "text",
          "column": "last_name"
        },
        {
          "code": "dob",
          "label": "Date of Birth",
          "type": "Date",
          "control": "date",
          "column": "dob",
          "default": true
        },
        {
          "code": "gender",
          "label": "Gender",
          "type": "List",
          "control": "select",
          "column": "gender",
          "options": [
            "Male",
            "Female",
            "Other",
            "Prefer not to say"
          ],
          "default": true
        },
        {
          "code": "marital_status",
          "label": "Marital Status",
          "type": "List",
          "control": "select",
          "column": "marital_status",
          "options": [
            "Single",
            "Married",
            "Divorced",
            "Widowed"
          ]
        },
        {
          "code": "father",
          "label": "Father's Name",
          "type": "Text",
          "control": "text",
          "column": "father",
          "default": true
        },
        {
          "code": "mother_name",
          "label": "Mother's Name",
          "type": "Text",
          "control": "text",
          "column": null
        },
        {
          "code": "spouse_name",
          "label": "Spouse Name",
          "type": "Text",
          "control": "text",
          "column": null
        },
        {
          "code": "blood_group",
          "label": "Blood Group",
          "type": "List",
          "control": "select",
          "column": "blood_group",
          "options": [
            "A+",
            "A-",
            "B+",
            "B-",
            "O+",
            "O-",
            "AB+",
            "AB-"
          ]
        },
        {
          "code": "nationality",
          "label": "Nationality",
          "type": "Text",
          "control": "text",
          "column": "nationality"
        },
        {
          "code": "category",
          "label": "Category",
          "type": "List",
          "control": "select",
          "column": "category",
          "options": [
            "General",
            "OBC",
            "SC",
            "ST",
            "EWS"
          ]
        },
        {
          "code": "id_marks",
          "label": "Identification Marks",
          "type": "Text",
          "control": "text",
          "column": "id_marks"
        },
        {
          "code": "physically_challenged",
          "label": "Physically Challenged",
          "type": "List",
          "control": "select",
          "column": null,
          "options": [
            "Yes",
            "No",
            "NA"
          ]
        },
        {
          "code": "photo_path",
          "label": "Photograph",
          "type": "Image/PDF/Doc",
          "control": "text",
          "column": "photo_path",
          "help": "The stored path of the photograph on file."
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact Details",
      "accent": "#3E5C76",
      "desc": "How to reach the employee, and who to call in an emergency.",
      "fields": [
        {
          "code": "email",
          "label": "Official Email",
          "type": "Email",
          "control": "text",
          "column": "email",
          "default": true
        },
        {
          "code": "personal_email",
          "label": "Personal Email",
          "type": "Email",
          "control": "text",
          "column": null
        },
        {
          "code": "mobile",
          "label": "Mobile Number",
          "type": "Numeric",
          "control": "text",
          "column": "mobile",
          "default": true,
          "pattern": "^[6-9][0-9]{9}$",
          "pattern_hint": "a 10-digit Indian mobile number starting 6–9"
        },
        {
          "code": "whatsapp",
          "label": "WhatsApp Number",
          "type": "Numeric",
          "control": "text",
          "column": "whatsapp",
          "pattern": "^[6-9][0-9]{9}$",
          "pattern_hint": "a 10-digit Indian mobile number starting 6–9"
        },
        {
          "code": "alternate_number",
          "label": "Alternate Contact Number",
          "type": "Numeric",
          "control": "text",
          "column": null,
          "pattern": "^[0-9]{10}$",
          "pattern_hint": "a 10-digit phone number"
        },
        {
          "code": "address",
          "label": "Present Address (single line, previous format)",
          "type": "Text",
          "control": "text",
          "column": "address",
          "default": false
        },
        {
          "code": "present_house_no",
          "label": "Present Address — House/Flat Number",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true,
          "replaces": ["address"]
        },
        {
          "code": "present_apartment",
          "label": "Present Address — Apartment/Building Name (if a flat)",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "present_road_street",
          "label": "Present Address — Road Number & Street Name",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "present_area",
          "label": "Present Address — Area",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "present_city",
          "label": "Present Address — City",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "present_pincode",
          "label": "Present Address — Pin/Zip Code",
          "type": "Alpha Numeric",
          "control": "text",
          "column": null,
          "default": true,
          "pattern": "^[0-9]{6}$",
          "pattern_hint": "a 6-digit PIN code"
        },
        {
          "code": "present_state",
          "label": "Present Address — State",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "permanent_address",
          "label": "Permanent Address (single line, previous format)",
          "type": "Text",
          "control": "text",
          "column": "permanent_address",
          "default": false
        },
        {
          "code": "permanent_house_no",
          "label": "Permanent Address — House/Flat Number",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true,
          "replaces": ["permanent_address"]
        },
        {
          "code": "permanent_apartment",
          "label": "Permanent Address — Apartment/Building Name (if a flat)",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "permanent_road_street",
          "label": "Permanent Address — Road Number & Street Name",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "permanent_area",
          "label": "Permanent Address — Area",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "permanent_city",
          "label": "Permanent Address — City",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "permanent_pincode",
          "label": "Permanent Address — Pin/Zip Code",
          "type": "Alpha Numeric",
          "control": "text",
          "column": null,
          "default": true,
          "pattern": "^[0-9]{6}$",
          "pattern_hint": "a 6-digit PIN code"
        },
        {
          "code": "permanent_state",
          "label": "Permanent Address — State",
          "type": "Text",
          "control": "text",
          "column": null,
          "default": true
        },
        {
          "code": "emergency_name",
          "label": "Emergency Contact Name",
          "type": "Text",
          "control": "text",
          "column": "emergency_name",
          "default": true
        },
        {
          "code": "emergency_phone",
          "label": "Emergency Contact Number",
          "type": "Numeric",
          "control": "text",
          "column": "emergency_phone",
          "default": true,
          "pattern": "^[0-9]{10}$",
          "pattern_hint": "a 10-digit phone number"
        },
        {
          "code": "emergency_relation",
          "label": "Emergency Contact Relation",
          "type": "List",
          "control": "select",
          "column": null,
          "options": [
            "Father",
            "Mother",
            "Spouse",
            "Sibling",
            "Friend",
            "Other"
          ]
        },
        {
          "code": "home_lat",
          "label": "Home Latitude",
          "type": "Numeric",
          "control": "text",
          "column": "home_lat",
          "decimals": 6,
          "help": "Used by field attendance to judge whether a punch was made from home."
        },
        {
          "code": "home_lng",
          "label": "Home Longitude",
          "type": "Numeric",
          "control": "text",
          "column": "home_lng",
          "decimals": 6
        },
        {
          "code": "geo_radius_km",
          "label": "Allowed Radius (km)",
          "type": "Numeric",
          "control": "number",
          "column": "geo_radius_km"
        }
      ]
    },
    {
      "id": "employment",
      "title": "Employee Details",
      "accent": "#A5691E",
      "desc": "Role, reporting line, and status within the organisation. THESE ARE THE FIELDS A SALARY COMPONENT RULE IS SCOPED BY — company, branch, department, team and designation decide which rule applies to this person, so a field left uncaptured here is a scope nobody can be matched on.",
      "fields": [
        {
          "code": "employer_company_id",
          "label": "Company",
          "type": "List",
          "control": "lookup",
          "column": "employer_company_id",
          "lookup": "companies",
          "scope": "company"
        },
        {
          "code": "branch_id",
          "label": "Branch",
          "type": "List",
          "control": "lookup",
          "column": "branch_id",
          "lookup": "branches",
          "scope": "branch",
          "default": true,
          "required": true
        },
        {
          "code": "department_id",
          "label": "Department",
          "type": "List",
          "control": "lookup",
          "column": "department_id",
          "lookup": "departments",
          "scope": "team",
          "default": true
        },
        {
          "code": "team_id",
          "label": "Team",
          "type": "List",
          "control": "lookup",
          "column": "team_id",
          "lookup": "teams"
        },
        {
          "code": "designation_id",
          "label": "Designation",
          "type": "List",
          "control": "lookup",
          "column": "designation_id",
          "lookup": "designations",
          "scope": "designation",
          "default": true
        },
        {
          "code": "role",
          "label": "Role",
          "type": "Text",
          "control": "derived",
          "column": "role",
          "help": "Set automatically from the employee's Designation, via Organization Configuration → Role / Designation Setup. Not editable here — change the Designation's Role there if it needs to be different."
        },
        {
          "code": "doj",
          "label": "Date of Joining",
          "type": "Date",
          "control": "date",
          "column": "doj",
          "default": true
        },
        {
          "code": "training_start_date",
          "label": "Training Start Date",
          "type": "Date",
          "control": "date",
          "column": "training_start_date",
          "default": true,
          "help": "Induction training. Whether training days are paid is the company's setting (Organization Configuration → Companies → Paid during training)."
        },
        {
          "code": "training_end_date",
          "label": "Training End Date",
          "type": "Date",
          "control": "date",
          "column": "training_end_date",
          "default": true,
          "help": "The date of production is the first working day after this. Unpaid training: salary starts on the date of production."
        },
        {
          "code": "employment_type",
          "label": "Employee Type",
          "type": "List",
          "control": "select",
          "column": "employment_type",
          "options": [
            "Permanent",
            "Fixed Term",
            "Contract",
            "Intern",
            "Consultant",
            "Probationary"
          ],
          "default": true,
          "required_on_form": true,
          "help": "Chosen for every employee — deliberately blank until somebody picks, so nobody is filed as Permanent because the box happened to start there (owner, 28 Sep). Probationary puts the employee on the Probation board; confirming them there changes this to Permanent."
        },
        {
          "code": "type",
          "label": "Staff Type",
          "type": "List",
          "control": "select",
          "column": "type",
          "options": [
            "Office",
            "Field"
          ],
          "help": "Office or field — this is what decides whether attendance expects a geo-tagged punch.",
          "default": true,
          "default_value": "office"
        },
        {
          "code": "grade_band",
          "label": "Grade / Band",
          "type": "List",
          "control": "lookup",
          "lookup": "grades",
          "lookup_note": "Owner, 12 Oct: the grades set on Organization Configuration → Designations, never typed.",
          "column": null
        },
        {
          "code": "reporting_manager_id",
          "label": "Reporting Manager",
          "type": "List",
          "control": "lookup",
          "column": "reporting_manager_id",
          "lookup": "employees", "none_option": {"value": "NONE", "label": "No one \u2014 top of the organisation"},
          "default": true,
          "required": true
        },
        {
          "code": "team_leader",
          "label": "Team Leader",
          "type": "List",
          "control": "lookup",
          "lookup": "employees",
          "column": "team_leader",
          "help": "Picked from the directory (28 Sep) — never typed."
        },
        {
          "code": "work_location",
          "label": "Work Location",
          "type": "List",
          "control": "lookup",
          "lookup": "branches",
          "column": null,
          "help": "One of the branches in Organization Setup (28 Sep) — never typed."
        },
        {
          "code": "business_unit",
          "label": "Business Unit",
          "type": "Text",
          "control": "text",
          "column": null
        },
        {
          "code": "cost_center",
          "label": "Cost Code",
          "type": "List",
          "control": "lookup",
          "lookup": "branch-codes",
          "column": null,
          "help": "Branch Code-Branch Name (e.g. HYD1-KONDAPUR), from Organization Setup → Branches. That whole string is what is stored."
        },
        {
          "code": "shift",
          "label": "Shift",
          "type": "List",
          "control": "lookup",
          "lookup": "shifts",
          "column": "shift",
          "help": "From Organization Setup → Shifts. This names the shift on the record; which shift actually applies on a given day is still worked out by scope (company/branch/department/designation/team/employee) the way Organization Setup → Shifts describes."
        },
        {
          "code": "schedule_id",
          "label": "Work Schedule",
          "type": "List",
          "control": "lookup",
          "lookup": "shifts",
          "help": "One of the shifts in Organization Configuration \u2192 Shifts (13 Oct) \u2014 never typed.",
          "column": "schedule_id"
        },
        {
          "code": "device_user_id",
          "label": "Biometric Device User ID",
          "type": "Alpha Numeric",
          "control": "text",
          "column": "device_user_id",
          "help": "What the punch machine calls this person. Without it an imported punch belongs to nobody.",
          "default": true,
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "pattern_hint": "letters, digits, - or _ only"
        },
        {
          "code": "probation_end",
          "label": "Probation End Date",
          "type": "Date",
          "control": "date",
          "column": null
        },
        {
          "code": "confirmation_date",
          "label": "Confirmation Date",
          "type": "Date",
          "control": "date",
          "column": null
        },
        {
          "code": "notice_period_days",
          "label": "Notice Period (Days)",
          "type": "Numeric",
          "control": "number",
          "column": null
        },
        {
          "code": "status",
          "label": "Employee Status",
          "type": "List",
          "control": "select",
          "column": "status",
          "options": [
            "Active",
            "Inactive",
            "Terminated",
            "Resigned",
            "Absconding"
          ],
          "default": true,
          "default_value": "active"
        },
        {
          "code": "employment_stage",
          "label": "Employee Stage",
          "type": "Text",
          "control": "text",
          "column": "employment_stage"
        },
        {
          "code": "also_works_for",
          "label": "Also Works For",
          "type": "List",
          "control": "lookup",
          "lookup": "companies",
          "column": "also_works_for"
        },
        {
          "code": "exit_date",
          "label": "Date of Exit",
          "type": "Date",
          "control": "date",
          "column": null,
          "help": "Leaving is recorded as a dated event on the employee timeline; this column is the summary."
        },
        {
          "code": "exit_reason",
          "label": "Reason for Exit",
          "type": "List",
          "control": "select",
          "column": null,
          "options": [
            "N/A - Active",
            "Resignation",
            "Termination",
            "Retirement",
            "End of Contract",
            "Death",
            "Disablement",
            "Other"
          ],
          "default_value": "N/A - Active",
          "help": "N/A - Active for a serving employee."
        },
        {
          "code": "rehire_eligible",
          "label": "Rehire Eligible",
          "type": "List",
          "control": "select",
          "column": null,
          "options": [
            "NA",
            "Yes",
            "No"
          ],
          "default_value": "NA",
          "help": "NA for a serving employee."
        }
      ]
    },
    {
      "id": "statutory",
      "title": "Statutory & Compliance",
      "accent": "#9C4A3A",
      "desc": "Government IDs, verification certificates and their deadlines. A component rule with the calculation 'Basis Employee status' reads PCC Status, DRA Status, PAN or National ID — so those four are what a status-driven deduction is decided by.",
      "fields": [
        {
          "code": "pan",
          "label": "PAN Number",
          "type": "Alpha Numeric",
          "control": "text",
          "column": "pan",
          "default": true,
          "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
          "pattern_hint": "a PAN like ABCDE1234F (5 letters, 4 digits, 1 letter)",
          "uppercase": true
        },
        {
          "code": "aadhaar",
          "label": "Aadhaar Number",
          "type": "Numeric",
          "control": "text",
          "column": "aadhaar",
          "default": true,
          "pattern": "^[2-9][0-9]{11}$",
          "pattern_hint": "a 12-digit Aadhaar number (never starts with 0 or 1)"
        },
        {
          "code": "national_id",
          "label": "National ID",
          "type": "Alpha Numeric",
          "control": "text",
          "column": "national_id"
        },
        {
          "code": "passport_no",
          "label": "Passport Number",
          "type": "Alpha Numeric",
          "control": "text",
          "column": null,
          "pattern": "^[A-Z][0-9]{7}$",
          "pattern_hint": "a passport number like A1234567",
          "uppercase": true
        },
        {
          "code": "passport_expiry",
          "label": "Passport Expiry Date",
          "type": "Date",
          "control": "date",
          "column": null
        },
        {
          "code": "pf_applicable",
          "label": "PF Applicable",
          "type": "List",
          "control": "select",
          "column": "pf_applicable",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "code": "uan",
          "label": "UAN Number",
          "type": "Numeric",
          "control": "text",
          "column": "uan",
          "pattern": "^[0-9]{12}$",
          "pattern_hint": "a 12-digit UAN"
        },
        {
          "code": "residential_status",
          "label": "Residential Status (Income Tax)",
          "type": "List",
          "control": "select",
          "column": null,
          "default": true,
          "options": ["Resident", "Non-resident"],
          "help": "For TDS. A non-resident gets no Section 156 (old 87A) rebate and no higher basic exemption for age. Blank is treated as Resident."
        },
        {
          "code": "nps_pran",
          "label": "NPS PRAN",
          "type": "Numeric",
          "control": "text",
          "column": null,
          "pattern": "^[0-9]{12}$",
          "default": true,
          "pattern_hint": "a 12-digit Permanent Retirement Account Number",
          "help": "Only when the employee is in NPS — the employer's NPS contribution (old 80CCD(2)) is deposited to this account."
        },
        {
          "code": "pf_no",
          "label": "PF Number",
          "type": "Alpha Numeric",
          "control": "text",
          "column": null,
          "pattern": "^[A-Za-z0-9/-]{6,30}$",
          "pattern_hint": "a PF number"
        },
        {
          "code": "esi_applicable",
          "label": "ESIC Applicable",
          "type": "List",
          "control": "select",
          "column": "esi_applicable",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "code": "esic_no",
          "label": "ESIC Number",
          "type": "Alpha Numeric",
          "control": "text",
          "column": "esic_no",
          "pattern": "^[0-9]{10,17}$",
