        "employee": "employee_id"
      },
      "columns": [
        "employee_id",
        "month",
        "state",
        "gross_wages",
        "pt_deducted",
        "pt_paid",
        "challan_no",
        "challan_date"
      ],
      "search": [
        "state",
        "challan_no",
        "remarks"
      ],
      "permissions": {
        "view": "payroll.view",
        "edit": "payroll.run"
      },
      "display": {
        "money": [
          "gross_wages",
          "pt_deducted",
          "pt_paid"
        ]
      },
      "fields": {
        "employee_id": {
          "label": "Employee",
          "required": true,
          "empty": "\u2014 pick \u2014",
          "lookup": {
            "table": "employees",
            "value": "id",
            "show": [
              "emp_code",
              "name"
            ]
          }
        },
        "month": {
          "label": "Wage month",
          "required": true
        },
        "state": {
          "label": "State",
          "help": "The state the PT is paid to \u2014 the employee's branch state"
        },
        "gross_wages": {
          "label": "Gross wages (\u20b9)",
          "type": "number",
          "min": 0
        },
        "pt_deducted": {
          "label": "PT deducted (\u20b9)",
          "type": "number",
          "min": 0
        },
        "pt_paid": {
          "label": "PT paid (\u20b9)",
          "type": "number",
          "min": 0
        },
        "challan_no": {
          "label": "Challan / receipt no."
        },
        "challan_date": {
          "label": "Paid on",
          "type": "date"
        },
        "remarks": {
          "label": "Remarks"
        }
      }
    }
  ]
}
